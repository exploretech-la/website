{
  "_comment": [
    "Inventory of every raster image actively rendered by the site, plus the",
    "encoding profile used to produce its optimized WebP variants.",
    "Edit this file (never src/static/optimized/** or src/constants/optimizedImages.ts)",
    "and re-run `node scripts/images.js`. See `node scripts/images.js --help`.",
    "Keys are the ORIGINAL path relative to src/static; the originals stay in the",
    "repository so generation is repeatable."
  ],
  "sourceRoot": "src/static",
  "outputRoot": "src/static/optimized",
  "manifestPath": "src/static/optimized/manifest.json",
  "mapPath": "src/constants/optimizedImages.ts",
  "profiles": {
    "portrait": {
      "_comment": "People.tsx renders headshots in a fixed 160x160 box; 320px square covers 2x displays. Deliberate square crop, centered unless the source needs a focus override.",
      "type": "portrait",
      "size": 320,
      "quality": 82,
      "minQuality": 60,
      "maxBytes": 102400
    },
    "content": {
      "_comment": "Photos rendered at layout width (carousel, About, GetInvolved, Ignite, registration banner). Aspect ratio preserved, never upscaled.",
      "type": "content",
      "widths": [640, 1280],
      "quality": 76,
      "minQuality": 55,
      "maxBytes": 307200
    },
    "logoLarge": {
      "_comment": "Sponsors .large-logos render at 14-16rem (224-256px). Near-lossless WebP preserves transparency and keeps flat artwork compact.",
      "type": "logo",
      "widths": [256, 512],
      "nearLossless": 60,
      "quality": 95,
      "maxBytes": 61440
    },
    "logoSmall": {
      "_comment": "Sponsors .small-logos render at 8-12rem (128-192px).",
      "type": "logo",
      "widths": [192, 384],
      "nearLossless": 60,
      "quality": 95,
      "maxBytes": 40960
    }
  },
  "scan": {
    "_comment": [
      "`--check` scans these trees for quoted `static/<path>.<ext>` raster references",
      "and for `images[\"<key>\"]` lookups, so a newly added photo cannot ship",
      "unoptimized or under a key that does not exist. Comment lines are ignored.",
      "Asset families listed in allowUnoptimized are deliberately out of scope:",
      "vector art stays vector, and maps/PDFs are click-only downloads."
    ],
    "roots": ["src"],
    "extensions": [".ts", ".tsx"],
    "allowUnoptimized": [
      "svg/",
      "maps/",
      "pdf/",
      "workshop-logos/",
      "panelists/",
      "community-partners/",
      "optimized/"
    ],
    "allowUnoptimizedPaths": []
  },
