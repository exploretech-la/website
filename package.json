{
  "name": "exploretech-la",
  "homepage": "https://www.exploretech.la",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "dependencies": {
    "bootstrap": "4.5.2",
    "classnames": "2.2.6",
    "prop-types": "15.7.2",
    "react": "16.13.1",
    "react-bootstrap": "1.3.0",
    "react-dom": "16.13.1",
    "react-ga": "3.1.2",
    "react-icons": "3.11.0",
    "react-router-dom": "5.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.5.6",
    "gh-pages": "6.3.0",
    "history": "4.10.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "sass": "1.104.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 3000",
    "images": "node scripts/images.js",
    "images:check": "node scripts/images.js --check",
    "prebuild": "npm run images:check",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": false,
    "fsevents@2.3.3": false
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
